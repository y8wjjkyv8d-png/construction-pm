# Шаблон секрету. Справжній файл secret.yaml НЕ зберігається в Git.
# Створення з командного рядка (рекомендовано):
#   kubectl -n construction-pm create secret generic construction-pm-secret \
#     --from-literal=TELEGRAM_BOT_TOKEN='<токен від @BotFather>'
apiVersion: v1
kind: Secret
metadata:
  name: construction-pm-secret
  namespace: construction-pm
  labels:
    app.kubernetes.io/name: construction-pm
type: Opaque
stringData:
  TELEGRAM_BOT_TOKEN: "<токен від @BotFather>"
