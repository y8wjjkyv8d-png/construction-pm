# Шаблон конфігурації оточення. Скопіюйте у .env (файл .env не потрапляє в Git).
APP_PORT=8000
CPM_LOG_LEVEL=info
CPM_DB_PATH=/data/construction.db

# Секрет: у compose вказується будь-яке значення, бо повідомлення йдуть у telegram-mock.
# Для справжнього Telegram — токен бота від @BotFather і прибрати TELEGRAM_API_BASE у docker-compose.yml.
TELEGRAM_BOT_TOKEN=change-me
